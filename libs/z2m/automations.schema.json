{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "urn:burki24:z2m-automations:schema:1",
    "title": "Z2MAutomations configuration v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "schema_version": {
            "const": 1
        },
        "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "automations": {
            "type": "array",
            "maxItems": 100,
            "items": {
                "$ref": "#/definitions/automation"
            }
        }
    },
    "required": [
        "schema_version",
        "revision",
        "automations"
    ],
    "definitions": {
        "device": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{16}$"
        },
        "jsonValue": {
            "anyOf": [
                {
                    "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                    ],
                    "maxLength": 256
                },
                {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                        "$ref": "#/definitions/jsonValue"
                    }
                },
                {
                    "type": "object",
                    "maxProperties": 32,
                    "propertyNames": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
                        "not": {
                            "enum": [
                                "__proto__",
                                "constructor",
                                "prototype"
                            ]
                        }
                    },
                    "additionalProperties": {
                        "$ref": "#/definitions/jsonValue"
                    }
                }
            ]
        },
        "deviceTrigger": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "const": "device"
                },
                "device": {
                    "$ref": "#/definitions/device"
                },
                "property": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
                    "not": {
                        "enum": [
                            "__proto__",
                            "constructor",
                            "prototype"
                        ]
                    }
                },
                "operator": {
                    "enum": [
                        "eq",
                        "ne",
                        "gt",
                        "gte",
                        "lt",
                        "lte"
                    ]
                },
                "value": {
                    "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                    ],
                    "maxLength": 256
                },
                "for_seconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 86400
                }
            },
            "required": [
                "type",
                "device",
                "property",
                "operator",
                "value"
            ],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "operator": {
                                "enum": [
                                    "gt",
                                    "gte",
                                    "lt",
                                    "lte"
                                ]
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "type": "number"
                            }
                        }
                    }
                }
            ]
        },
        "timeTrigger": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "const": "time"
                },
                "at": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
                },
                "timezone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                }
            },
            "required": [
                "type",
                "at",
                "timezone"
            ]
        },
        "deviceCondition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "const": "device_value"
                },
                "device": {
                    "$ref": "#/definitions/device"
                },
                "property": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
                    "not": {
                        "enum": [
                            "__proto__",
                            "constructor",
                            "prototype"
                        ]
                    }
                },
                "operator": {
                    "enum": [
                        "eq",
                        "ne",
                        "gt",
                        "gte",
                        "lt",
                        "lte"
                    ]
                },
                "value": {
                    "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                    ],
                    "maxLength": 256
                }
            },
            "required": [
                "type",
                "device",
                "property",
                "operator",
                "value"
            ],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "operator": {
                                "enum": [
                                    "gt",
                                    "gte",
                                    "lt",
                                    "lte"
                                ]
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "type": "number"
                            }
                        }
                    }
                }
            ]
        },
        "timeCondition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "const": "time_window"
                },
                "after": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
                },
                "before": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
                },
                "timezone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                },
                "weekdays": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 7,
                    "uniqueItems": true,
                    "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 7
                    }
                }
            },
            "required": [
                "type",
                "after",
                "before",
                "timezone"
            ]
        },
        "target": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "const": "device"
                        },
                        "id": {
                            "$ref": "#/definitions/device"
                        }
                    },
                    "required": [
                        "type",
                        "id"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "const": "group"
                        },
                        "id": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                        }
                    },
                    "required": [
                        "type",
                        "id"
                    ]
                }
            ]
        },
        "action": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "const": "set"
                },
                "target": {
                    "$ref": "#/definitions/target"
                },
                "values": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 32,
                    "propertyNames": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
                        "not": {
                            "enum": [
                                "__proto__",
                                "constructor",
                                "prototype"
                            ]
                        }
                    },
                    "additionalProperties": {
                        "$ref": "#/definitions/jsonValue"
                    }
                },
                "delay_seconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 86400
                }
            },
            "required": [
                "type",
                "target",
                "values"
            ]
        },
        "automation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                },
                "enabled": {
                    "type": "boolean"
                },
                "triggers": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/definitions/deviceTrigger"
                            },
                            {
                                "$ref": "#/definitions/timeTrigger"
                            }
                        ]
                    }
                },
                "conditions": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/definitions/deviceCondition"
                            },
                            {
                                "$ref": "#/definitions/timeCondition"
                            }
                        ]
                    }
                },
                "actions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                        "$ref": "#/definitions/action"
                    }
                }
            },
            "required": [
                "id",
                "name",
                "enabled",
                "triggers",
                "conditions",
                "actions"
            ]
        }
    }
}
