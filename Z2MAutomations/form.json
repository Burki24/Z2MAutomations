{
    "elements": [
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Enable MQTT connection"
        },
        {
            "type": "ValidationTextBox",
            "name": "BaseTopic",
            "caption": "Zigbee2MQTT base topic"
        },
        {
            "type": "NumberSpinner",
            "name": "RequestTimeout",
            "caption": "Response timeout (seconds)",
            "minimum": 1,
            "maximum": 120
        },
        {
            "type": "Label",
            "caption": "Use the existing MQTT gateway. Subscribe to BaseTopic/bridge/# and BaseTopic/symcon/automations/#."
        },
        {
            "type": "Label",
            "caption": "Installation requires external JavaScript already enabled in Z2M. Storing YAML does not activate automations."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Check Zigbee2MQTT connection",
            "onClick": "Z2MA_CheckHealth($id);"
        },
        {
            "caption": "Refresh extension status",
            "type": "Button",
            "onClick": "Z2MA_RequestExtensionStatus($id);"
        },
        {
            "confirm": "Install the bundled z2m-automations.mjs in Z2M and replace an existing file with this name?",
            "caption": "Install or update bundled extension",
            "type": "Button",
            "onClick": "Z2MA_InstallExtension($id);",
            "name": "InstallButton"
        },
        {
            "caption": "Idle",
            "name": "OperationInfo",
            "type": "Label"
        },
        {
            "caption": "No extension error.",
            "name": "ErrorInfo",
            "type": "Label"
        },
        {
            "type": "Label",
            "name": "ExecutionInfo",
            "caption": "Execution state unknown. Refresh extension status."
        },
        {
            "type": "Label",
            "name": "RuntimeErrorInfo",
            "caption": "No execution error."
        },
        {
            "type": "Button",
            "name": "ActivateButton",
            "caption": "Activate stored automations in Z2M",
            "confirm": "Activate the currently stored revision in Z2M? Enabled automations may switch devices and continue without Symcon.",
            "onClick": "Z2MA_ActivateAutomations($id);",
            "enabled": false
        },
        {
            "type": "Button",
            "name": "StopButton",
            "caption": "Stop automations in Z2M",
            "onClick": "Z2MA_StopAutomations($id);"
        },
        {
            "type": "Label",
            "caption": "Create a simple automation by choosing devices and actions. Validate, store and activate the draft afterwards."
        },
        {
            "type": "Button",
            "caption": "Load devices and stored automations",
            "confirm": "Replace the local draft with the currently stored Z2M configuration? Nothing in Z2M will be changed.",
            "onClick": "Z2MA_LoadAutomationEditor($id);"
        },
        {
            "type": "Select",
            "name": "EditorRule",
            "caption": "Automation to edit",
            "value": "",
            "options": [
                {
                    "caption": "Create a new automation",
                    "value": ""
                }
            ],
            "onChange": "Z2MA_SelectAutomation($id, $EditorRule, $ShowYamlControl ? $YamlInput : '', $ShowYamlControl);"
        },
        {
            "type": "ValidationTextBox",
            "name": "EditorEditToken",
            "caption": "Selection reference",
            "value": "",
            "visible": false
        },
        {
            "type": "Label",
            "name": "EditorEditInfo",
            "caption": "Changes affect the local draft. Validate and store it afterwards."
        },
        {
            "type": "ValidationTextBox",
            "name": "EditorName",
            "caption": "Automation name",
            "value": ""
        },
        {
            "type": "CheckBox",
            "name": "EditorEnabled",
            "caption": "Rule enabled",
            "value": true
        },
        {
            "type": "Select",
            "name": "EditorSource",
            "caption": "Source device",
            "options": [
                {
                    "caption": "Choose device",
                    "value": ""
                }
            ],
            "value": "",
            "onChange": "Z2MA_SelectEditorDevice($id, 'Source', $EditorSource);"
        },
        {
            "type": "Select",
            "name": "EditorSourceChoice",
            "caption": "When this event occurs",
            "options": [
                {
                    "caption": "Choose event or action",
                    "value": ""
                }
            ],
            "value": ""
        },
        {
            "type": "Select",
            "name": "EditorTarget",
            "caption": "Target device",
            "options": [
                {
                    "caption": "Choose device",
                    "value": ""
                }
            ],
            "value": "",
            "onChange": "Z2MA_SelectEditorDevice($id, 'Target', $EditorTarget);"
        },
        {
            "type": "Select",
            "name": "EditorTargetChoice",
            "caption": "Perform this action",
            "options": [
                {
                    "caption": "Choose event or action",
                    "value": ""
                }
            ],
            "value": ""
        },
        {
            "type": "Button",
            "caption": "Add automation to draft",
            "onClick": "Z2MA_CreateSimpleAutomation($id, $EditorName, $EditorSource, $EditorSourceChoice, $EditorTarget, $EditorTargetChoice, $ShowYamlControl ? $YamlInput : '', $ShowYamlControl, $EditorEnabled);",
            "name": "CreateRuleButton"
        },
        {
            "type": "Button",
            "name": "UpdateRuleButton",
            "caption": "Apply changes to draft",
            "visible": false,
            "onClick": "Z2MA_UpdateAutomation($id, $EditorRule, $EditorEditToken, $EditorName, $EditorEnabled, $EditorSource, $EditorSourceChoice, $EditorTarget, $EditorTargetChoice, $ShowYamlControl ? $YamlInput : '', $ShowYamlControl);"
        },
        {
            "type": "Button",
            "name": "DeleteRuleButton",
            "caption": "Delete selected automation from draft",
            "enabled": false,
            "confirm": "Delete the selected automation from the local draft? The running Z2M configuration changes only after validating and storing the draft.",
            "onClick": "Z2MA_DeleteAutomation($id, $EditorRule, $EditorEditToken, $ShowYamlControl ? $YamlInput : '', $ShowYamlControl);"
        },
        {
            "type": "Label",
            "name": "EditorPreview",
            "caption": "Load the editor to choose devices."
        },
        {
            "type": "List",
            "name": "EditorRules",
            "caption": "Draft automations",
            "rowCount": 4,
            "columns": [
                {
                    "name": "Name",
                    "caption": "Automation name",
                    "width": "30%"
                },
                {
                    "name": "Source",
                    "caption": "Source device",
                    "width": "30%"
                },
                {
                    "name": "Target",
                    "caption": "Target device",
                    "width": "30%"
                },
                {
                    "name": "Enabled",
                    "caption": "Enabled",
                    "width": "10%"
                }
            ],
            "values": []
        },
        {
            "type": "CheckBox",
            "name": "ShowYamlControl",
            "caption": "Show advanced YAML editor",
            "value": false,
            "onChange": "Z2MA_ShowYamlEditor($id, $ShowYamlControl);"
        },
        {
            "value": "",
            "caption": "Automation YAML draft",
            "name": "YamlInput",
            "rowCount": 18,
            "type": "ScriptEditor",
            "visible": false
        },
        {
            "caption": "Validate draft in Z2M",
            "type": "Button",
            "onClick": "$ShowYamlControl ? Z2MA_ValidateYaml($id, $YamlInput) : Z2MA_ValidateAutomationDraft($id);"
        },
        {
            "caption": "No current YAML validation.",
            "name": "ValidationInfo",
            "type": "Label"
        },
        {
            "confirm": "Store exactly the validated YAML in Z2M and replace its stored configuration? Activation is a separate step.",
            "caption": "Store validated draft in Z2M",
            "type": "Button",
            "onClick": "$ShowYamlControl ? Z2MA_StoreYaml($id, $YamlInput) : Z2MA_StoreAutomationDraft($id);",
            "name": "StoreButton"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "MQTT connected and Zigbee2MQTT online"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "MQTT connection disabled"
        },
        {
            "code": 200,
            "icon": "error",
            "caption": "Invalid base topic or response timeout"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "No active compatible MQTT parent"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Zigbee2MQTT offline or state not received"
        }
    ]
}
