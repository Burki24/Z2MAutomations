{
    "elements": [
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Enable MQTT connection"
        },
        {
            "type": "ValidationTextBox",
            "name": "BaseTopic",
            "caption": "Zigbee2MQTT base topic"
        },
        {
            "type": "NumberSpinner",
            "name": "RequestTimeout",
            "caption": "Response timeout (seconds)",
            "minimum": 1,
            "maximum": 120
        },
        {
            "type": "Label",
            "caption": "Use the existing MQTT gateway. Subscribe to BaseTopic/bridge/# and BaseTopic/symcon/automations/#."
        },
        {
            "type": "Label",
            "caption": "Installation requires external JavaScript already enabled in Z2M. Stored YAML is not executed."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Check Zigbee2MQTT connection",
            "onClick": "Z2MA_CheckHealth($id);"
        },
        {
            "caption": "Refresh extension status",
            "type": "Button",
            "onClick": "Z2MA_RequestExtensionStatus($id);"
        },
        {
            "confirm": "Install the bundled z2m-automations.mjs in Z2M and replace an existing file with this name?",
            "caption": "Install or update bundled extension",
            "type": "Button",
            "onClick": "Z2MA_InstallExtension($id);",
            "name": "InstallButton"
        },
        {
            "caption": "Idle",
            "name": "OperationInfo",
            "type": "Label"
        },
        {
            "caption": "No extension error.",
            "name": "ErrorInfo",
            "type": "Label"
        },
        {
            "value": "",
            "caption": "Automation YAML draft",
            "name": "YamlInput",
            "rowCount": 18,
            "type": "ScriptEditor"
        },
        {
            "caption": "Validate YAML in Z2M",
            "type": "Button",
            "onClick": "Z2MA_ValidateYaml($id, $YamlInput);"
        },
        {
            "caption": "No current YAML validation.",
            "name": "ValidationInfo",
            "type": "Label"
        },
        {
            "confirm": "Store exactly the validated YAML in Z2M and replace its stored configuration? Automations will not be executed.",
            "caption": "Store validated YAML in Z2M",
            "type": "Button",
            "onClick": "Z2MA_StoreYaml($id, $YamlInput);",
            "name": "StoreButton"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "MQTT connected and Zigbee2MQTT online"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "MQTT connection disabled"
        },
        {
            "code": 200,
            "icon": "error",
            "caption": "Invalid base topic or response timeout"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "No active compatible MQTT parent"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Zigbee2MQTT offline or state not received"
        }
    ]
}
