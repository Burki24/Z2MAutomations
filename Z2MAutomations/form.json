{
    "elements": [
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Enable MQTT connection"
        },
        {
            "type": "ValidationTextBox",
            "name": "BaseTopic",
            "caption": "Zigbee2MQTT base topic"
        },
        {
            "type": "NumberSpinner",
            "name": "RequestTimeout",
            "caption": "Response timeout (seconds)",
            "minimum": 1,
            "maximum": 120
        },
        {
            "type": "Label",
            "caption": "Connect this instance to the existing MQTT Client or MQTT Server. Subscribe to the base topic followed by /bridge/# in the MQTT Client."
        },
        {
            "type": "Label",
            "caption": "Automation editing, YAML transfer and extension installation are not available yet."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Check Zigbee2MQTT connection",
            "onClick": "Z2MA_CheckHealth($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "MQTT connected and Zigbee2MQTT online"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "MQTT connection disabled"
        },
        {
            "code": 200,
            "icon": "error",
            "caption": "Invalid base topic or response timeout"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "No active compatible MQTT parent"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Zigbee2MQTT offline or state not received"
        }
    ]
}
